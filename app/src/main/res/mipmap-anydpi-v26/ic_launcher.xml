<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the two layers are flat images, and the launcher supplies the
     mask. The foreground carries the mark inside the 66dp safe zone so no mask
     shape clips it; below API 26 the raster ic_launcher.png is used instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
